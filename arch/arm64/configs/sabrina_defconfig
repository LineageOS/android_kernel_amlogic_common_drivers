# Thermal
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_STEP_WISE=y
# CONFIG_THERMAL_DEFAULT_GOV_POWER_ALLOCATOR is not set
# CONFIG_THERMAL_GOV_POWER_ALLOCATOR is not set

# Board thermistors
CONFIG_HWMON=m
CONFIG_SENSORS_NTC_THERMISTOR=m

# Status LEDs
CONFIG_LEDS_PWM=m

# USB-C power input
CONFIG_GOOGLE_TYPEC_TCPM=m
CONFIG_GOOGLE_TYPEC_TCPCI=m
CONFIG_GOOGLE_TYPEC_RT1711H=m
CONFIG_GOOGLE_USB_POWER_MONITOR=m

# BL40
CONFIG_AMLOGIC_FIRMWARE=m
