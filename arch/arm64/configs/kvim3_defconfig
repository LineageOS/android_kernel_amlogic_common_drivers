# amlogic-snd-codec-es8316.ko - the Khadas variant of everest,es8316, adds
# the speaker-enable GPIO and SARADC headphone detect the VIM3 needs.
CONFIG_AMLOGIC_SND_SOC_ES8316=m

# TCA6408 GPIO expander on i2c_AO@0x20. Mainline gpio-pca953x replaces the
# out-of-tree khadas-tca6408 driver; it also backs the red_led gpio-leds
# child (expander line 5), which on 4.9 needed a khadas-redled driver.
CONFIG_GPIO_PCA953X=y

# HYM8563 RTC on i2c_AO@0x51.
CONFIG_RTC_DRV_HYM8563=m

# KXTJ3 accelerometer on i2c_AO@0x0e, via the sensor-dev framework imported
# from the vim4-a14 BSP. All three are bool/tristate default y in their
# Kconfig, listed here so the dependency is explicit rather than implicit.
CONFIG_SENSOR_DEVICE=y
CONFIG_GSENSOR_DEVICE=y
CONFIG_GS_KXTJ3=y

