		skin_thermal: skin_thermal {
			polling-delay = <1000>;
			polling-delay-passive = <100>;
			thermal-sensors = <&thermistor_wifi>;
			coefficients = <1 (-3500)>;
			trips {
				skin_trip0: trip-point@0 {
					temperature = <69000>;
					hysteresis = <1000>;
					type = "passive";
				};
				skin_trip1: trip-point@1 {
					temperature = <70000>;
					hysteresis = <1000>;
					type = "passive";
				};
				skin_trip2: trip-point@2 {
					temperature = <71000>;
					hysteresis = <1000>;
					type = "passive";
				};
				skin_trip3: trip-point@3 {
					temperature = <72000>;
					hysteresis = <1000>;
					type = "passive";
				};
				skin_critical: trip-point@4 {
					temperature = <73000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				cpufreq_cooling_map0 {
					trip = <&skin_trip0>;
					cooling-device = <&CPU0 0 4>;
				};
				cpufreq_cooling_map1 {
					trip = <&skin_trip1>;
					cooling-device = <&CPU0 5 6>;
				};
				cpufreq_cooling_map2 {
					trip = <&skin_trip2>;
					cooling-device = <&CPU0 7 7>;
				};
				cpufreq_cooling_map3 {
					trip = <&skin_trip3>;
					cooling-device = <&CPU0 8 8>;
				};
				gpufreq_cooling_map0 {
					trip = <&skin_trip0>;
					cooling-device = <&gpufreq_cool0 1 1>;
				};
				gpufreq_cooling_map1 {
					trip = <&skin_trip1>;
					cooling-device = <&gpufreq_cool0 2 2>;
				};
			};
		};

		usb_power_vthermal: usb_power_vthermal {
			polling-delay = <2000>;
			polling-delay-passive = <1000>;
			thermal-sensors = <&usb_power_monitor>;
			trips {
				usb_power_low: trip-point@0 {
					temperature = <(-2500000)>;
					hysteresis = <0>;
					type = "passive";
				};
			};
		};
	};

	cpu_opp_table0: cpu_opp_table0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp00 {
			opp-hz = /bits/ 64 <100000000>;
			opp-microvolt = <760000>;
		};
		opp01 {
			opp-hz = /bits/ 64 <250000000>;
			opp-microvolt = <760000>;
		};
		opp02 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <760000>;
		};
		opp03 {
			opp-hz = /bits/ 64 <666666666>;
			opp-microvolt = <780000>;
		};
		opp04 {
			opp-hz = /bits/ 64 <1000000000>;
			opp-microvolt = <800000>;
		};
		opp05 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <810000>;
		};
		opp06 {
			opp-hz = /bits/ 64 <1404000000>;
			opp-microvolt = <820000>;
		};
		opp07 {
			opp-hz = /bits/ 64 <1500000000>;
			opp-microvolt = <830000>;
		};
		opp08 {
			opp-hz = /bits/ 64 <1608000000>;
			opp-microvolt = <860000>;
		};
		opp09 {
			opp-hz = /bits/ 64 <1704000000>;
			opp-microvolt = <900000>;
		};
		opp10 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-microvolt = <940000>;
		};
		opp11 {
			opp-hz = /bits/ 64 <1908000000>;
			opp-microvolt = <1000000>;
		};
	};

